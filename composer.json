{
  "name": "kumwe/automation",
  "description": "Portable automation contracts and behavior extracted from Kumwe.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.5",
    "kumwe/canonical-json": "dev-main",
    "kumwe/contribution": "^0.1",
    "kumwe/access-context": "^0.1",
    "psr/clock": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\Automation\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "lint": "php tools/verify.php --lint",
    "architecture": "php tools/verify.php --architecture",
    "manifests": "php tools/verify.php --manifests",
    "manifests:record": "php tools/verify.php --write",
    "check": [
      "composer validate --strict",
      "@lint",
      "@architecture",
      "@manifests",
      "@analyse",
      "@cs",
      "@test:ownership",
      "@test"
    ],
    "clean-consumer": "php tools/verify-clean-consumer.php",
    "analyse": "phpstan analyse --no-progress",
    "cs": "phpcs -q",
    "test:ownership": "php tools/verify-ownership.php"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/tools",
      "/CHARTER.md",
      "/.gitignore",
      "/.phpstan-cache",
      "/phpstan.neon",
      "/phpcs.xml",
      "/.github"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
